{
  "name": "seandinwiddie-com-static",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run generate && npm run check && npm run deploy:artifact",
    "generate": "npm run social && npm run sitemap",
    "social": "node scripts/generate-social-images.mjs",
    "sitemap": "node scripts/generate-sitemaps.mjs",
    "sync:components": "node scripts/sync-shared-page-components.mjs",
    "check": "npm run check:components && npm run check:site && npm run check:accessibility && npm run check:performance",
    "check:components": "node scripts/sync-shared-page-components.mjs --check",
    "check:site": "node scripts/check-site.mjs",
    "check:accessibility": "node scripts/check-accessibility.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "deploy:artifact": "node scripts/build-deploy.mjs",
    "preview": "node scripts/preview-server.cjs . 8765"
  }
}
